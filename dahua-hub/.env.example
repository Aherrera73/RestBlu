# Copia este archivo a %LOCALAPPDATA%\RestBlu\dahua-hub.env.local y ajústalo.
# Las credenciales de SQL Server se toman de %LOCALAPPDATA%\RestBlu\.env.local
# (RESTBLU_SQLSERVER_*) salvo que se definan aquí con DAHUA_HUB_SQLSERVER_*.

# Listener TCP de Auto Register. ngrok entrega las conexiones en localhost;
# usa 0.0.0.0 si también quieres que se conecten Dahua de tu red local.
DAHUA_HUB_TCP_HOST=127.0.0.1
DAHUA_HUB_TCP_PORT=9500
# Opcional: dirección TCP reservada en ngrok (plan compatible), host:puerto.
# El lanzador la usa al iniciar ngrok y evita aceptar otra dirección por error.
NGROK_TCP_ADDRESS=
# Tiempo para que una conexión nueva envíe su registro (el Dahua tarda hasta 30 s).
DAHUA_HUB_REGISTRATION_TIMEOUT_MS=90000
# 0 = una conexión registrada puede quedar en silencio sin cortarse.
DAHUA_HUB_IDLE_TIMEOUT_MS=0
DAHUA_HUB_TCP_KEEPALIVE_MS=30000
DAHUA_HUB_MAX_CONNECTIONS=200
# true = un Registration ID desconocido se da de alta solo (sólo para pruebas).
DAHUA_HUB_ALLOW_UNKNOWN_DEVICES=false
# Certificado para los terminales con HTTPs activado en su Registro Automático
# CGI (se genera con: node scripts/generate-certificates.mjs). El mismo puerto
# acepta terminales con y sin HTTPS.
DAHUA_HUB_TLS_CERT=
DAHUA_HUB_TLS_KEY=

# API REST (sólo local por omisión). Con clave, cada petición necesita x-api-key.
DAHUA_HUB_API_HOST=127.0.0.1
DAHUA_HUB_API_PORT=3200
DAHUA_HUB_API_KEY=

# sqlserver o memory (sin base, se pierde al cerrar).
DAHUA_HUB_STORE=sqlserver
# fake = FakeDahuaClient (sin hardware); dahua = terminal real por Auto Register.
DAHUA_HUB_CLIENT=dahua

# Cuenta CGI con la que el hub inicia sesión en los terminales. Si se dejan
# vacías se usa la del gestor (DAHUA_USERNAME / DAHUA_PASSWORD_BASE64).
DAHUA_HUB_DEVICE_USERNAME=
DAHUA_HUB_DEVICE_PASSWORD_BASE64=
# Cada cuánto se renueva la sesión CGI (el terminal la vence a los 60 s).
DAHUA_HUB_DEVICE_KEEPALIVE_MS=40000
# Zona horaria del reloj de los terminales (vigencia de los usuarios).
DAHUA_HUB_DEVICE_TIMEZONE=America/Santiago
DAHUA_HUB_DEVICE_DOOR=1
DAHUA_HUB_COMMAND_INTERVAL_MS=2000
DAHUA_HUB_COMMAND_BATCH=10
