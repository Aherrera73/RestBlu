<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="RestBlu_Definiciones" targetNamespace="http://restblu.cl/bpmn" exporter="RestBlu" exporterVersion="1.0">
  <bpmn:collaboration id="Colaboracion_RestBlu">
    <bpmn:participant id="Pool_RestBlu" name="RestBlu: reserva y acceso" processRef="Proceso_Reserva" />
  </bpmn:collaboration>
  <bpmn:process id="Proceso_Reserva" name="Reserva y acceso RestBlu" isExecutable="false">
    <bpmn:laneSet id="Carriles">
      <bpmn:lane id="L_huesped" name="Huésped (app / web)">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T18</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_firebase" name="Firebase (nube)">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_gestor" name="Gestor RestBlu (PC)">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T22</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_webpay" name="Webpay Transbank">
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_hub" name="Hub Dahua (PC)">
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T23</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_dahua" name="Terminal Dahua (vivienda)">
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T19</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T20</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T21</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Quiere reservar">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Iniciar sesión (correo o Google)">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Cuenta con RUT y correo verificado?" gatewayDirection="Diverging">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2" name="Completar registro: RUT único y código de 6 dígitos">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="" gatewayDirection="Converging">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Elegir alojamiento, fechas y huéspedes">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T4" name="Guardar solicitud (reservation_intake)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T5" name="Validar datos y recalcular el precio">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="¿Fechas disponibles?" gatewayDirection="Diverging">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Crear reserva pendiente de pago (60 min)">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T6" name="Rechazar: fechas ocupadas">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Reserva rechazada">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T8" name="Pagar con Webpay">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T9" name="Autorizar el pago con tarjeta">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T10" name="Verificar el pago en Transbank">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="¿Pago aprobado?" gatewayDirection="Diverging">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T12" name="Confirmar reserva y generar código QR">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T11" name="Liberar fechas: reserva expirada">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Reserva expirada">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T13" name="Enviar persona, QR y vigencia al terminal">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T14" name="Registrar huésped (válido del check-in al check-out)">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T15" name="Enviar correo de confirmación con PDF">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T16" name="Publicar estado y QR dinámico">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T17" name="Ver el QR en la app o la web">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T18" name="Presentar el QR en el lector">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="¿QR válido y vigente?" gatewayDirection="Diverging">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T19" name="Abrir la puerta">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T20" name="Rechazar el acceso">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T21" name="Registrar movimiento (entrada / salida)">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T24" name="Registrar el intento rechazado">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Acceso denegado (puede reintentar)">
      <bpmn:incoming>F31</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T22" name="Copiar el movimiento a Seguridad">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IE1" name="Llega el check-out">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IE1_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T23" name="Eliminar la persona del terminal">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E3" name="Estadía finalizada">
      <bpmn:incoming>F35</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" name="" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="" sourceRef="T1" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="No" sourceRef="G1" targetRef="T2" />
