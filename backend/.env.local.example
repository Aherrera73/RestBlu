# Configuración privada de RestBlu.
# El configurador copia esta plantilla a %LOCALAPPDATA%\RestBlu\.env.local.
# No compartas, comprimas ni subas ese archivo o el JSON de Firebase.

# Obligatorio para recibir reservas creadas desde teléfonos u otros computadores.
# Usa una ruta absoluta al JSON de cuenta de servicio descargado desde Firebase.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Users\TU_USUARIO\Downloads\lumastay-firebase-adminsdk.json

# Obligatorio para enviar verificaciones y comprobantes.
# Ejemplo Gmail: activa la verificación en dos pasos y usa una contraseña de aplicación.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
# Puede quedar vacío: RestBlu usará SMTP_USER como remitente.
MAIL_FROM=

# Servidor de IA compatible con OpenAI. Guarda la clave real únicamente
# en %LOCALAPPDATA%\RestBlu\.env.local, nunca en el frontend.
AI_BASE_URL=https://tu-servidor.example:8443/v1
AI_API_KEY=sk-local-reemplazar
AI_MODEL=ia-local:latest

# Servidor biométrico 1:1. El servicio remoto no conserva imágenes; RestBlu
# cifra localmente la plantilla facial con AES-256-GCM y descarta cada captura.
BIOMETRIC_BASE_URL=https://tu-servidor-biometrico.example/biometria/v1
BIOMETRIC_API_KEY=sk-bio-reemplazar
BIOMETRIC_DATA_KEY=reemplazar-por-32-bytes-en-base64
BIOMETRIC_ENROLL_PATH=/enroll
BIOMETRIC_VERIFY_PATH=/verify
BIOMETRIC_HEALTH_PATH=/health
BIOMETRIC_MATCH_THRESHOLD=0.75

# Terminal facial Dahua (se recomienda usar Configurar_Dahua_Reservas.bat)
# DAHUA_BASE_URL=http://172.26.10.160
# DAHUA_USERNAME=usuario-cgi
# DAHUA_PASSWORD_BASE64=
# Sólo con https: certificado CA propio, o 1 para aceptar el autofirmado de fábrica.
# DAHUA_CA_CERT_PATH=
# DAHUA_ALLOW_SELF_SIGNED=0
# DAHUA_RESERVATION_SYNC=1
